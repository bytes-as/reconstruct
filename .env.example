# Copy to .env and fill in. Never commit .env.

# FalkorDB
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=

# Public data sources (no login needed)
OPENFDA_API_KEY=                          # free key from open.fda.gov; without it openFDA allows 1,000 requests/day per IP
DAILYMED_BASE_URL=https://dailymed.nlm.nih.gov/dailymed
OPENFDA_BASE_URL=https://api.fda.gov
DAILYMED_RPS=2                            # self-imposed politeness cap (DailyMed publishes no limit)
HTTP_CONTACT=team@example.com             # sent in the User-Agent so source operators can reach us
CACHE_DIR=.cache

# Verdict policy
GRACE_DAYS=30                             # display policy for NOT_LANDED_REVISED vs NOT_LANDED_UNREVISED (not a legal standard)
AS_OF_OVERRIDE=                           # YYYY-MM-DD; freezes "today" for the eval (empty in production)
LANDFALL_FIXTURE_MODE=0                   # 1 = load data/fixtures/hub_montelukast.json into hub and skip network ingest

# Optional LLM via OpenRouter for explanation phrasing, drafts, the Ask router, the pharmacy agent --llm and the eval baseline
OPENROUTER_API_KEY=
LLM_MODEL=                                # required if OPENROUTER_API_KEY is set: an exact id from https://openrouter.ai/api/v1/models
LLM_DAILY_BUDGET_CALLS=500
EVAL_BASELINE_MODELS=                     # comma-separated OpenRouter model ids for the LLM baseline

# Security
ADMIN_TOKEN=change-me
PUBLISHER_SALT=change-me-long-random
CORS_ORIGINS=http://localhost:3001,https://your-app.vercel.app

# Jobs
WATCH_INTERVAL_MINUTES=60
SANDBOX_TTL_MINUTES=120
WEB_BASE_URL=http://localhost:3001        # used in MCP text results ("Details: <WEB_BASE_URL>/ndc/<ndc>")

# Web app (apps/web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
